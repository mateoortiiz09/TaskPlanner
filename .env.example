SECRET_KEY=replace-with-a-generated-local-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
POSTGRES_DB=taskplanner_dev
POSTGRES_USER=taskplanner_app
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
SESION_INACTIVIDAD_MINUTOS=15
SESION_DURACION_MAXIMA_HORAS=10
DIAS_EN_RIESGO=2

# Adjuntos
ADJUNTOS_DIR=
ADJUNTOS_CLAVE_MAESTRA=
ADJUNTOS_TAMANO_MAX_MB=20
ANTIVIRUS_ACTIVO=False
ANTIVIRUS_COMANDO=clamdscan --no-summary --fdpass

# Correo (en local, Mailpit en localhost:1025)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_USE_TLS=False
DEFAULT_FROM_EMAIL=TaskPlanner <notificaciones@proscience.local>
TASKPLANNER_URL_BASE=http://127.0.0.1:8000
NOTIFICACIONES_MAX_INTENTOS=5
